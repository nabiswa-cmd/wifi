# --- Core ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-domain.vercel.app,localhost

# --- Database (Supabase Postgres) ---
DATABASE_URL=postgres://user:password@db.supabase.co:5432/postgres

# --- Safaricom Daraja ---
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# BusinessShortCode — the HO/store number that went live on Daraja
# (the API authenticates against this one).
MPESA_SHORTCODE=4348331
# PartyB — the actual till number customers use to pay via SIM Toolkit
# or the M-PESA app. Different from MPESA_SHORTCODE above for a Till.
MPESA_TILL_NUMBER=3453945
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.vercel.app/api/mpesa/callback/
# You're on a Till, so leave this as TILL (uses CustomerBuyGoodsOnline,
# PartyB = MPESA_TILL_NUMBER). Only change to PAYBILL if you later move
# to a paybill number (in which case PartyB = MPESA_SHORTCODE instead).
MPESA_ACCOUNT_TYPE=TILL

# --- Background worker auth (for the separate expiry/MikroTik worker) ---
INTERNAL_TASK_TOKEN=change-me-too

# --- MikroTik (per-router creds also stored in DB, this is a fallback/default) ---
MIKROTIK_API_TIMEOUT=5
