   <div class="app-shell">
 
     <header class="topbar">
@@ -145,30 +111,6 @@
   </div>
 
   <script src="{% static 'js/theme.js' %}"></script>
-  <script>
-    /* Hide the WiFi loader once the page has loaded.
-       MIN_SHOW is 2600ms (was 700) so the Wi-Fi icon has time to sweep out into
-       the spinning rainbow rings before the loader fades. Lower it if you
-       want pages to appear faster on slow hotspot connections. */
-    (function () {
-      var MIN_SHOW = 2600;
-      var loader = document.getElementById('page-loader');
-      if (!loader) return;
-      var start = Date.now(), hidden = false;
-      function hide() {
-        if (hidden) return;
-        hidden = true;
-        var wait = Math.max(0, MIN_SHOW - (Date.now() - start));
-        setTimeout(function () {
-          loader.classList.add('done');
-          setTimeout(function () { loader.style.display = 'none'; }, 500);
-        }, wait);
-      }
-      if (document.readyState === 'complete') { hide(); }
-      else { window.addEventListener('load', hide); }
-      setTimeout(hide, 6000); /* safety net for slow hotspot connections */
-    })();
-  </script>
