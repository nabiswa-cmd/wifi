+<script>
+(function () {
+  // "Other / custom reason" toggle: show the text box only when needed.
+  document.querySelectorAll('form[data-reason-form]').forEach(function (form) {
+    var sel = form.querySelector('.reason-select');
+    var custom = form.querySelector('.reason-custom');
+    if (!sel || !custom) return;
+    sel.addEventListener('change', function () {
+      var other = sel.value === 'OTHER';
+      custom.hidden = !other;
+      custom.required = other;
+    });
+  });
+
+  // One request at a time for the whole page. Once any form is submitted,
+  // every button shows a spinner / is disabled and further submits are
+  // ignored, so a double-click (or clicking another row) can't burn extra
+  // adjustments while the first request is still being processed.
+  var busy = false;
+  document.querySelectorAll('form[data-spin]').forEach(function (form) {
+    form.addEventListener('submit', function (e) {
+      if (busy) { e.preventDefault(); return; }
+      busy = true;
+
+      // Only one of the two "reason" fields may be sent.
+      var sel = form.querySelector('.reason-select');
+      var custom = form.querySelector('.reason-custom');
+      if (sel && custom) {
+        if (sel.value === 'OTHER') { sel.removeAttribute('name'); } else { custom.removeAttribute('name'); }
+      }
+
+      var btn = form.querySelector('button[type=submit]');
+      var label = btn.querySelector('.btn-label');
+      if (label && btn.dataset.loadingText) { label.innerHTML = btn.dataset.loadingText; }
+      btn.classList.add('is-loading');
+      btn.setAttribute('aria-busy', 'true');
+
+      // Disable after the browser has captured the form data.
+      setTimeout(function () {
+        document.querySelectorAll('form[data-spin] button[type=submit]').forEach(function (b) { b.disabled = true; });
+      }, 0);
+    });
+  });
+
+  // Coming back via the browser's back button must not leave buttons frozen.
+  window.addEventListener('pageshow', function (e) { if (e.persisted) { window.location.reload(); } });
+})();
+</script>
 {% endblock %}
