+  .stat-tile {
+    position: relative; display: flex; align-items: center; gap: 12px; padding: 14px; min-width: 0;
+    background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 8px;
+    color: inherit; text-decoration: none; transition: border-color .15s ease, transform .15s ease;
+  }
+  a.stat-tile:hover { border-color: var(--color-primary); transform: translateY(-1px); }
+  a.stat-tile:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
+  .stat-icon {
+    position: relative; flex: 0 0 42px; width: 42px; height: 42px; border-radius: 50%;
