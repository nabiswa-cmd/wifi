+  .tone-purple { --tone: #8b5cf6; }
+  .stat-body { display: flex; flex-direction: column; min-width: 0; flex: 1; }
+  .stat-label { font-size: .78rem; color: var(--color-text-muted); font-weight: 600; }
+  .stat-value { font-size: 1.5rem; font-weight: 700; line-height: 1.2; overflow-wrap: anywhere; }
